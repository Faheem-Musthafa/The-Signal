# =============================================================================
# Next.js app — copy to .env.local for local dev, and set in Vercel for deploys
# =============================================================================

# Convex deployment used by `npx convex dev` (written automatically by the CLI)
CONVEX_DEPLOYMENT=
# Convex client URL, e.g. https://<deployment>.convex.cloud
NEXT_PUBLIC_CONVEX_URL=
# Convex HTTP actions URL, e.g. https://<deployment>.convex.site
NEXT_PUBLIC_CONVEX_SITE_URL=

# Clerk keys from the Clerk dashboard (API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Public origin of the site, no trailing slash (metadataBase, sitemap, robots), e.g. https://example.com
NEXT_PUBLIC_SITE_URL=

# =============================================================================
# Convex backend — NOT read from this file. Set each one on the deployment with:
#   npx convex env set NAME value          (add --prod for production)
# Provider keys (OpenRouter, Firecrawl, Resend) live ONLY here; Next.js never needs them.
# =============================================================================

# Clerk Frontend API URL used to verify Convex auth tokens, e.g. https://<app>.clerk.accounts.dev
# CLERK_JWT_ISSUER_DOMAIN=
# Svix signing secret of the Clerk webhook pointing at <NEXT_PUBLIC_CONVEX_SITE_URL>/clerk-webhook (user.deleted)
# CLERK_WEBHOOK_SECRET=

# OpenRouter API key for digest generation
# OPENROUTER_API_KEY=
# Optional: primary OpenRouter model ID
# OPENROUTER_MODEL=
# Optional: comma-separated fallback model IDs tried in order
# OPENROUTER_MODEL_FALLBACKS=
# Optional: max completion tokens per request (capped server-side)
# OPENROUTER_MAX_TOKENS=

# Firecrawl API key for scraping source articles
# FIRECRAWL_API_KEY=
# Optional: country code for Firecrawl search (default US)
# FIRECRAWL_COUNTRY=

# Resend API key for newsletter email
# RESEND_API_KEY=
# Verified sender, e.g. "The Signal <digest@example.com>"
# EMAIL_FROM=
# Physical postal address shown in email footers (CAN-SPAM); footer line omitted if unset
# EMAIL_POSTAL_ADDRESS=
# Random secret (32+ bytes) used to sign unsubscribe links, e.g. `openssl rand -hex 32`
# UNSUB_SECRET=
# Public site origin used in email links, no trailing slash (same value as NEXT_PUBLIC_SITE_URL)
# SITE_URL=
